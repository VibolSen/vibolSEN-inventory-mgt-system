				{
					"name": "System Health & DB Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": ["{{baseUrl}}"],
							"path": ["actuator", "health"]
						},
						"description": "Verifies that Spring Boot and TiDB MySQL database connections are healthy (UP)."
					}
				}
			]
		},
